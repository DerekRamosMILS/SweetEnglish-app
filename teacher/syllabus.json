      "units": ["U09","U10","U11","U12","U13","U14","U15","U16"]
    },
    {
      "id": "B1",
      "title": "Independent Communication",
      "description": "Can handle most situations in daily life, express ideas clearly, understand main points of standard topics.",
      "estimated_weeks": 16,
      "units": ["U17","U18","U19","U20","U21","U22","U23","U24"]
    },
    {
      "id": "B2",
      "title": "Upper Intermediate",
      "description": "Can interact fluently with native speakers, understand complex texts, express ideas with precision.",
      "estimated_weeks": 16,
      "units": ["U25","U26","U27","U28"]
    },
    {
      "id": "C1",
      "title": "Advanced Mastery",
      "description": "Can express herself spontaneously, flexibly, and effectively for complex social and professional purposes.",
      "estimated_weeks": 12,
      "units": ["U29","U30","U31","U32"]
    }
  ],
